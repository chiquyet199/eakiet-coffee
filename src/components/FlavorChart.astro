---
import { FLAVOR_AXES } from '../utils/taxonomy';

type Profile = Partial<Record<keyof typeof FLAVOR_AXES, number>>;

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const axes = Object.entries(FLAVOR_AXES) as [keyof typeof FLAVOR_AXES, string][];
const MAX = 5;
const size = 280;
const c = size / 2;
const r = 95;

const point = (i: number, value: number) => {
  const angle = (Math.PI * 2 * i) / axes.length - Math.PI / 2;
  const d = (r * value) / MAX;
  return [c + d * Math.cos(angle), c + d * Math.sin(angle)] as const;
};
const polygon = (value: (i: number) => number) =>
  axes.map((_, i) => point(i, value(i)).map((n) => n.toFixed(1)).join(',')).join(' ');
---

<figure class="flex flex-col items-center gap-4 sm:flex-row sm:items-center">
  <svg viewBox={`0 0 ${size} ${size}`} class="h-64 w-64 shrink-0" role="img" aria-label="Biểu đồ hương vị">
    {[1, 2, 3, 4, 5].map((level) => (
      <polygon points={polygon(() => level)} fill="none" class="stroke-coffee-200" stroke-width="1" />
    ))}
    {axes.map((_, i) => {
      const [x, y] = point(i, MAX);
      return <line x1={c} y1={c} x2={x} y2={y} class="stroke-coffee-200" stroke-width="1" />;
    })}
    <polygon
      points={polygon((i) => profile[axes[i][0]] ?? 0)}
      class="fill-ripe-500/30 stroke-ripe-500"
      stroke-width="2"
      stroke-linejoin="round"
    />
    {axes.map(([, label], i) => {
      const [x, y] = point(i, MAX + 1.3);
      return (
        <text x={x} y={y} text-anchor="middle" dominant-baseline="middle" class="fill-coffee-800 text-[11px] font-medium">
          {label}
        </text>
      );
    })}
  </svg>
  <dl class="grid w-full grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-2 text-sm">
    {axes.map(([key, label]) => (
      <>
        <dt class="text-coffee-600">{label}</dt>
        <dd class="h-2 overflow-hidden rounded-full bg-coffee-100">
          <span class="block h-full rounded-full bg-ripe-500" style={`width: ${((profile[key] ?? 0) / MAX) * 100}%`}></span>
        </dd>
        <dd class="font-semibold text-coffee-900">{profile[key] ?? 0}/{MAX}</dd>
      </>
    ))}
  </dl>
</figure>
