---
interface Props {
  title: string;
  year?: number;
  description?: string;
  image?: string;
  organization?: string;
}

const { title, year, description, image, organization } = Astro.props;
---

<article class="overflow-hidden rounded-xl border border-coffee-200 bg-white p-5 shadow-sm">
  {image && (
    <a href={image} target="_blank" rel="noopener noreferrer" class="mb-4 block aspect-[4/3] overflow-hidden rounded-lg bg-coffee-100">
      <img src={image} alt={title} class="h-full w-full object-contain" loading="lazy" width="400" height="300" />
    </a>
  )}
  <div class="flex items-baseline justify-between gap-2">
    <h3 class="font-sans text-base font-semibold text-coffee-900">{title}</h3>
    {year && <span class="shrink-0 text-sm font-medium text-leaf-700">{year}</span>}
  </div>
  {organization && <p class="mt-1 text-sm text-coffee-500">{organization}</p>}
  {description && <p class="mt-2 text-sm text-coffee-700">{description}</p>}
</article>
