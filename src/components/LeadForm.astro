---
import { LEAD_NEEDS, LEAD_TYPES, TURNSTILE_SITE_KEY } from '../utils/leads';

interface Props {
  /** quote = short B2B quote form (homepage); contact = full form with enquiry type routing */
  variant?: 'quote' | 'contact';
  /** On dark backgrounds */
  dark?: boolean;
}

const { variant = 'quote', dark = false } = Astro.props;
const contactTypes = Object.entries(LEAD_TYPES).filter(([key]) => key !== 'quote');
---

<form
  action="/api/lead"
  method="post"
  class="lead-form grid gap-4 sm:grid-cols-2"
  data-variant={variant}
>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  {variant === 'quote' && <input type="hidden" name="type" value="quote" />}
  <!-- Honeypot -->
  <div class="hidden" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  {variant === 'contact' && (
    <fieldset class="sm:col-span-2">
      <legend class="form-label">Bạn cần hỗ trợ về</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        {contactTypes.map(([value, label], i) => (
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-coffee-200 bg-white px-3 py-2.5 text-sm has-[:checked]:border-leaf-700 has-[:checked]:bg-leaf-50">
            <input type="radio" name="type" value={value} checked={i === 0} class="accent-leaf-700" />
            {label}
          </label>
        ))}
      </div>
    </fieldset>
  )}

  <div>
    <label class:list={['form-label', dark && '!text-coffee-100']} for={`${variant}-name`}>Họ tên *</label>
    <input id={`${variant}-name`} name="name" required maxlength="100" autocomplete="name" class="form-input" />
  </div>
  <div>
    <label class:list={['form-label', dark && '!text-coffee-100']} for={`${variant}-phone`}>Số điện thoại *</label>
    <input
      id={`${variant}-phone`}
      name="phone"
      type="tel"
      required
      pattern="[0-9+\s().\-]{8,20}"
      autocomplete="tel"
      class="form-input"
    />
  </div>

  {variant === 'quote' ? (
    <>
      <div>
        <label class:list={['form-label', dark && '!text-coffee-100']} for="quote-need">Nhu cầu mua</label>
        <select id="quote-need" name="need" class="form-input">
          {LEAD_NEEDS.map((need) => <option>{need}</option>)}
        </select>
      </div>
      <div>
        <label class:list={['form-label', dark && '!text-coffee-100']} for="quote-quantity">Số lượng dự kiến</label>
        <input id="quote-quantity" name="quantity" maxlength="60" placeholder="VD: 5 tấn/tháng" class="form-input" />
      </div>
    </>
  ) : (
    <>
      <div>
        <label class="form-label" for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" maxlength="120" autocomplete="email" class="form-input" />
      </div>
      <div>
        <label class="form-label" for="contact-product">Sản phẩm quan tâm</label>
        <input id="contact-product" name="product" maxlength="120" class="form-input" />
      </div>
      <div class="sm:col-span-2">
        <label class="form-label" for="contact-message">Nội dung</label>
        <textarea id="contact-message" name="message" rows="4" maxlength="2000" class="form-input"></textarea>
      </div>
    </>
  )}

  <div class="sm:col-span-2">
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="vi"></div>
  </div>

  <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-lg bg-ripe-500 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-ripe-600 disabled:opacity-60"
    >
      {variant === 'quote' ? 'Gửi yêu cầu báo giá' : 'Gửi yêu cầu'}
    </button>
    <p class:list={['lead-status text-sm', dark ? 'text-coffee-100' : 'text-coffee-700']} role="status" aria-live="polite"></p>
  </div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { LEAD_TYPES } from '../utils/leads';

  declare global {
    interface Window {
      turnstile?: { reset: (el?: Element) => void };
    }
  }

  const params = new URLSearchParams(location.search);

  for (const form of document.querySelectorAll<HTMLFormElement>('form.lead-form')) {
    const status = form.querySelector<HTMLElement>('.lead-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    // Contact form deep links: /contact?type=sample&product=<name>
    if (form.dataset.variant === 'contact') {
      const type = params.get('type');
      if (type && type in LEAD_TYPES) {
        const radio = form.querySelector<HTMLInputElement>(`input[name="type"][value="${type}"]`);
        if (radio) radio.checked = true;
      }
      const product = params.get('product');
      if (product) form.querySelector<HTMLInputElement>('input[name="product"]')!.value = product;
      const error = params.get('error');
      if (error) status.textContent = error;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = 'Đang gửi…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (data.ok) {
          form.reset();
          status.textContent = 'Cảm ơn bạn! Chúng tôi sẽ liên hệ lại trong thời gian sớm nhất.';
        } else {
          status.textContent = data.error ?? 'Không gửi được yêu cầu. Vui lòng thử lại.';
        }
      } catch {
        status.textContent = 'Không gửi được yêu cầu. Vui lòng gọi hotline hoặc nhắn Zalo.';
      } finally {
        button.disabled = false;
        window.turnstile?.reset(form.querySelector('.cf-turnstile') ?? undefined);
      }
    });
  }
</script>
