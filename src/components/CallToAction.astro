---
interface Props {
  href?: string;
  text?: string;
  /** primary = orange CTA, secondary = outline, light = outline for dark backgrounds */
  variant?: 'primary' | 'secondary' | 'light';
  target?: string;
}

const { href = '/contact', text = 'Liên hệ ngay', variant = 'primary', target } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center rounded-lg px-6 py-3 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-ripe-500 focus:ring-offset-2',
    variant === 'primary' && 'bg-ripe-500 text-white shadow-sm hover:bg-ripe-600',
    variant === 'secondary' && 'border-2 border-coffee-900 text-coffee-900 hover:bg-coffee-100',
    variant === 'light' && 'border-2 border-white/80 text-white hover:bg-white/10',
  ]}
>
  {text}
</a>
