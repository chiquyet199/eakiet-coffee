---
import { CONTACT, ZALO_URL } from '../utils/constants';
---

<div class="fixed bottom-4 right-4 z-40 flex flex-col gap-3 sm:bottom-6 sm:right-6">
  <a
    href={ZALO_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-[#0068ff] text-sm font-bold text-white shadow-lg ring-4 ring-white transition hover:scale-105"
    aria-label="Chat Zalo"
    title="Chat Zalo"
  >
    Zalo
  </a>
  <a
    href={CONTACT.tel}
    class="flex h-14 w-14 items-center justify-center rounded-full bg-ripe-500 text-white shadow-lg ring-4 ring-white transition hover:scale-105"
    aria-label={`Gọi ${CONTACT.phone}`}
    title={`Gọi ${CONTACT.phone}`}
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z" />
    </svg>
  </a>
</div>
