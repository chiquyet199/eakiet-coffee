---
import type { CollectionEntry } from 'astro:content';
import { formatPrice } from '../utils/formatPrice';
import { BEAN_TYPES, PROCESS_METHODS, PRODUCT_LINES } from '../utils/taxonomy';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { data } = product;
const tags = [data.beanType && BEAN_TYPES[data.beanType], data.processMethod && PROCESS_METHODS[data.processMethod]].filter(Boolean);
---

<article
  class="product-card group overflow-hidden rounded-xl border border-coffee-200 bg-white shadow-sm transition hover:shadow-md"
  data-line={data.productLine}
  data-bean={data.beanType ?? ''}
  data-process={data.processMethod ?? ''}
>
  <a href={`/products/${product.slug}`} class="block">
    <div class="aspect-[4/3] overflow-hidden bg-coffee-100">
      <img
        src={data.mainImage}
        alt={data.title}
        class="h-full w-full object-cover transition group-hover:scale-105"
        loading="lazy"
        width="400"
        height="300"
      />
    </div>
    <div class="p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-leaf-700">{PRODUCT_LINES[data.productLine]}</p>
      <h2 class="mt-1 font-serif text-lg font-bold text-coffee-900 group-hover:text-ripe-600">{data.title}</h2>
      {tags.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-full bg-leaf-50 px-2 py-0.5 text-xs font-medium text-leaf-700">{tag}</span>
          ))}
        </div>
      )}
      <p class="mt-2 line-clamp-2 text-sm text-coffee-600">{data.description}</p>
      <p class="mt-3 font-semibold text-coffee-900">{formatPrice(data.price, data.currency)}</p>
    </div>
  </a>
</article>
