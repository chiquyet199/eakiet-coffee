---
import { getCollection } from 'astro:content';

const certifications = (await getCollection('awards', (a) => a.data.kind === 'certification')).sort(
  (a, b) => a.data.order - b.data.order
);
---

{certifications.length > 0 && (
  <ul class="flex flex-wrap items-center justify-center gap-6 sm:gap-10">
    {certifications.map((cert) => (
      <li class="flex flex-col items-center gap-2" title={cert.data.organization ?? cert.data.title}>
        {cert.data.image ? (
          <img src={cert.data.image} alt={cert.data.title} class="h-20 w-auto object-contain sm:h-24" loading="lazy" height="96" />
        ) : (
          <span class="flex h-20 w-20 items-center justify-center rounded-full border-2 border-leaf-700 p-2 text-center text-xs font-bold text-leaf-700 sm:h-24 sm:w-24">
            {cert.data.title}
          </span>
        )}
      </li>
    ))}
  </ul>
)}
