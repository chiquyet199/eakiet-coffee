---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { CONTACT, LEGAL, SITE_LEGAL_NAME, ZALO_URL } from '../utils/constants';

const tel = CONTACT.tel;
---

<BaseLayout title="Liên hệ & Hợp tác" description={`Liên hệ ${SITE_LEGAL_NAME} — mua sỉ, làm đại lý, nhận mẫu thử.`}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10">
      <h1 class="text-3xl text-coffee-900 sm:text-4xl">Liên hệ & Hợp tác</h1>
      <p class="mt-2 text-coffee-600">Mua sỉ, làm đại lý, nhận mẫu thử hay mua lẻ — Ban quản lý HTX luôn sẵn sàng hỗ trợ.</p>
    </header>

    <div class="grid gap-10 lg:grid-cols-5">
      <div class="space-y-6 lg:col-span-2">
        <div class="rounded-xl border border-coffee-200 bg-white p-6 shadow-sm">
          <h2 class="font-sans text-lg font-semibold text-coffee-900">Thông tin hành chính</h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div><dt class="text-coffee-500">Tên pháp lý</dt><dd class="font-medium text-coffee-900">{SITE_LEGAL_NAME}</dd></div>
            <div><dt class="text-coffee-500">Mã số thuế</dt><dd class="text-coffee-900">{LEGAL.taxCode}</dd></div>
            <div><dt class="text-coffee-500">Đại diện pháp luật</dt><dd class="text-coffee-900">{LEGAL.representative}</dd></div>
            <div><dt class="text-coffee-500">Trụ sở</dt><dd class="text-coffee-900">{LEGAL.office}</dd></div>
            <div><dt class="text-coffee-500">Nhà xưởng</dt><dd class="text-coffee-900">{LEGAL.factory}</dd></div>
            <div><dt class="text-coffee-500">Email</dt><dd><a href={`mailto:${CONTACT.email}`} class="text-coffee-900 hover:text-ripe-600">{CONTACT.email}</a></dd></div>
            <div><dt class="text-coffee-500">Giờ làm việc</dt><dd class="text-coffee-900">{CONTACT.hours}</dd></div>
          </dl>
        </div>

        <div class="rounded-xl bg-leaf-700 p-6 text-white">
          <h2 class="font-sans text-lg font-semibold">Hotline / Zalo Ban quản lý</h2>
          <a href={tel} class="mt-2 block font-serif text-2xl font-bold">{CONTACT.phone}</a>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={tel} class="rounded-lg bg-ripe-500 px-4 py-2 text-sm font-semibold hover:bg-ripe-600">Gọi ngay</a>
            <a href={ZALO_URL} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-[#0068ff] hover:bg-leaf-50">
              Chat Zalo
            </a>
          </div>
        </div>
      </div>

      <section id="lien-he" class="rounded-xl border border-coffee-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3">
        <h2 class="text-xl text-coffee-900">Gửi yêu cầu</h2>
        <p class="mb-6 mt-1 text-sm text-coffee-600">Chúng tôi sẽ phản hồi trong thời gian sớm nhất.</p>
        <LeadForm variant="contact" />
      </section>
    </div>

    <div class="mt-10 aspect-[16/7] min-h-64 overflow-hidden rounded-xl border border-coffee-200 bg-coffee-100">
      <iframe
        title="Bản đồ"
        src={`https://maps.google.com/maps?q=${encodeURIComponent(LEGAL.mapQuery)}&z=13&output=embed`}
        class="h-full w-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</BaseLayout>
