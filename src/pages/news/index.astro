---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { NEWS_CATEGORIES } from '../../utils/taxonomy';

const news = await getCollection('news', (n) => n.data.published);
const sorted = news.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
const filters = [['', 'Tất cả'], ...Object.entries(NEWS_CATEGORIES)];
---

<BaseLayout title="Tin tức & Kiến thức" description="Tin tức HTX, kiến thức cà phê và câu chuyện nông dân Tây Nguyên.">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-8">
      <h1 class="text-3xl text-coffee-900 sm:text-4xl">Tin tức & Kiến thức</h1>
      <p class="mt-2 text-coffee-600">Hoạt động HTX, kiến thức pha chế & thị trường, và những câu chuyện gắn bó với đất và cây cà phê.</p>
    </header>

    {sorted.length > 0 ? (
      <>
        <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Chuyên mục">
          {filters.map(([value, label], i) => (
            <button
              type="button"
              data-category={value}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="news-filter rounded-full border border-coffee-300 px-4 py-1.5 text-sm font-medium text-coffee-800 transition aria-pressed:border-coffee-900 aria-pressed:bg-coffee-900 aria-pressed:text-white"
            >
              {label}
            </button>
          ))}
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {sorted.map((article) => (
            <NewsCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              image={article.data.featuredImage}
              slug={article.slug}
              date={article.data.publishedDate}
              category={article.data.category}
            />
          ))}
        </div>
        <p id="news-empty" class="hidden rounded-xl border border-dashed border-coffee-300 p-8 text-center text-coffee-600">
          Chưa có bài viết trong chuyên mục này.
        </p>
      </>
    ) : (
      <p class="rounded-xl border border-coffee-200 bg-white p-8 text-center text-coffee-600">
        Chưa có bài viết nào. Quản trị viên có thể thêm tin tức qua CMS.
      </p>
    )}
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.news-filter');
  const cards = document.querySelectorAll<HTMLElement>('.news-card');
  const empty = document.getElementById('news-empty');

  function select(category: string) {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.category === category));
    let visible = 0;
    for (const card of cards) {
      const show = !category || card.dataset.category === category;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    }
    empty?.classList.toggle('hidden', visible > 0);
  }

  for (const b of buttons) b.addEventListener('click', () => select(b.dataset.category ?? ''));
  const initial = new URLSearchParams(location.search).get('category');
  if (initial && [...buttons].some((b) => b.dataset.category === initial)) select(initial);
</script>
